# Devangi Sewing Classes SMS - root .htaccess
# Blocks direct browser access to source/data folders that must never be
# served as plain files (config, includes, database dumps, install lock).

<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|env|log)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(sql|env|log)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Never allow the folders below to be browsed or their files fetched directly.
RewriteEngine On
RewriteRule ^config/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^database/ - [F,L]

Options -Indexes
