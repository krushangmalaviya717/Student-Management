# Devangi Sewing Classes SMS - root .htaccess
# Blocks direct browser access to source/data folders, archives, and internal scripts.

<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|env|log|zip|bak|md|lock|json)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(sql|env|log|zip|bak|md|lock|json)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Never allow sensitive folders or test scripts to be browsed or fetched directly.
RewriteEngine On
RewriteRule ^config/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^database/ - [F,L]
RewriteRule ^storage/ - [F,L]
RewriteRule ^test_check\.php$ - [F,L]

Options -Indexes
